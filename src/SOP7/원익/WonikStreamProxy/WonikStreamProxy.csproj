<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    WonikStreamProxy
      go2rtc(미디어 서버) 앞단에 두는 인증 리버스 프록시.
      - 요청의 ?token=<JWT> (또는 쿠키)를 검증(HMAC-SHA256, WebSOPApp 과 동일 비밀키)한 뒤에만 go2rtc 로 전달.
      - WebSocket(go2rtc MSE, /api/ws) 프록시 지원(YARP).
      - go2rtc 는 localhost 로 숨기고, 이 프록시만 공개 포트로 노출한다.

    빌드/배포: .NET 8 SDK 필요. 자세한 publish 옵션은 README.md 참고.
      (self-contained 단일 exe 로 빌드하면 런타임 미설치 Windows 서버에서도 실행 가능)
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WonikStreamProxy</RootNamespace>
    <AssemblyName>WonikStreamProxy</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 게시 결과 폴더는 빌드 산출물이므로 프로젝트 항목/솔루션 탐색기에서 제외한다. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**;publish-console\**;publish-service\**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    빌드 모드 스위치 (SERVICE 심볼)
      · 콘솔  : 그냥 빌드/게시 (심볼 없음)            → 일반 콘솔 앱 (UseWindowsService 미포함)
      · 서비스: SERVICE 심볼 정의                     → Windows 서비스로 동작 (UseWindowsService 포함)
    SERVICE 를 켜는 방법 두 가지 (아무거나):
      (1) 속성으로:   dotnet publish ... -p:ServiceMode=true
      (2) 구성으로:   VS 구성 관리자에서 Release 를 복사한 'Service' 구성으로 빌드/게시
                      (또는 CLI: dotnet publish -c Service ...)
      · VS 게시 프로필(.pubxml)에 <ServiceMode>true</ServiceMode> 한 줄 추가해도 동일.
  -->
  <PropertyGroup Condition="'$(ServiceMode)' == 'true' Or '$(Configuration)' == 'Service'">
    <DefineConstants>$(DefineConstants);SERVICE</DefineConstants>
  </PropertyGroup>

  <!-- 'Service' 구성은 Release 처럼 최적화되도록 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Service'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

</Project>
