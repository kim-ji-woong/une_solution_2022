{
  // 프록시가 수신할 주소(공개 포트). go2rtc 가 쓰던 1984 를 프록시가 대신 받는다.
  "Urls": "http://0.0.0.0:1984",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },

  "Auth": {
    // true 여야 토큰 검증. WebSOPApp/프론트에서 토큰을 발급·전달하도록 배포한 뒤 켤 것.
    "Enabled": true,
    // WebSOPApp appsettings 의 Auth:Secret 과 반드시 동일하게(32자 이상 랜덤).
    "Secret": "CHANGE_ME__SHARED_SECRET__AT_LEAST_32_CHARS__________",
    // 스트림 토큰의 iss/aud. WebSOPApp 의 스트림 토큰 발급 엔드포인트가 이 값으로 발급해야 한다.
    "Issuer": "WebSOPApp",
    "Audience": "go2rtc",
    "CookieName": "go2rtc_auth"
  },

  "ReverseProxy": {
    "Routes": {
      "all": {
        "ClusterId": "go2rtc",
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "go2rtc": {
        "Destinations": {
          // go2rtc 를 localhost 로 숨기고 여기로 전달한다. (go2rtc.yaml: api.listen: "127.0.0.1:1985")
          "d1": { "Address": "http://127.0.0.1:1985/" }
        }
      }
    }
  }
}
