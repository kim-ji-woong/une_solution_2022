<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!-- LPR 이벤트 검색 API -->
    <!-- API URL (쿼리 스트링은 코드에서 생성) -->
    <add key="LPR_API_URL" value="http://192.168.1.100/setup/log/log.cgi" />
    <!-- HTTP Digest 인증 계정 -->
    <add key="LPR_USER_ID" value="admin" />
    <add key="LPR_USER_PW" value="admin" />
    <!-- 페이지당 로그 개수 (page_size) -->
    <add key="LPR_PAGE_SIZE" value="100" />
    <!-- 조회할 페이지 인덱스 (page_index) : 1 = 최신 페이지 -->
    <add key="LPR_PAGE_INDEX" value="1" />
    <!-- API 호출 주기 (ms) -->
    <add key="LPR_POLL_INTERVAL" value="1000" />
    <!-- HTTP 타임아웃 (ms) -->
    <add key="LPR_TIMEOUT" value="5000" />
    <!-- 응답(XML 원문) 저장 파일 경로. 값이 비어 있으면 저장하지 않는다. -->
    <add key="LPR_RESPONSE_FILE" value="C:\UNE\Log\WonikLPR\WonikLPR_response.log" />
  </appSettings>
</configuration>
