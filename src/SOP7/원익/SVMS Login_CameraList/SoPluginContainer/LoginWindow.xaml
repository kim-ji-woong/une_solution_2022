<Window x:Class="SoPluginContainer.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoPluginContainer"
        mc:Ignorable="d"
        Title="SVMS Login" Height="236.179" Width="324.747">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Content="Server IP" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Label Grid.Row="1" Content="Port" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBox x:Name="ServerIPTextBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5" Text="10.6.13.11" />
            <TextBox x:Name="PortTextBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5" Text="8020" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Content="ID" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Label Grid.Row="1" Content="Password" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBox x:Name="UserTextBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5" Text="root" />
            <PasswordBox x:Name="PassTextBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5" Password="root@passwd1!" />
        </Grid>
        <Button Content="Connect" Grid.Row="2" Margin="10" Click="Button_Click"></Button>
    </Grid>
    
</Window>
