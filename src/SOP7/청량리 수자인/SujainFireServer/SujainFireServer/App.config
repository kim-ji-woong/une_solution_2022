    <add key ="EXTERNAL_PW" value="9449966Ab" />
    <!--<add key ="EXTERNAL_PW" value="!1q2w3e" />-->

    <!-- Log -->
    <add key="logFolder" value="C:\UNE\Log\SujainFireServer"/>
    <!--<add key="logFolder" value="D:\UnE\Log\SujainFireServer"/>-->
    <!-- 로그 저장기간(일)-->
    <add key="logLifeTime" value="30"/>
